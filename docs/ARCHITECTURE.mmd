graph TB
    subgraph "User Interface Layer"
        UI[UI Package<br/>Terminal Rendering]
        BANNER[Banner Display]
        THEME[Theme Controller]
    end

    subgraph "Application Layer"
        CMD[Command Line<br/>Entry Point]
        CONFIG[Config Package<br/>State Management]
        HEALTH[Health Package<br/>System Monitoring]
    end

    subgraph "Core Logic Layer"
        GEN[Generator Package<br/>Password Engine]
        CRYPTO[Crypto Package<br/>Vault & Recovery]
        VALIDATOR[Name Validation]
        HASH[SHA-256 Hashing]
    end

    subgraph "Core Geolocation Engine"
        GEO_RESOLVER[Geo Resolver<br/>(Interface-based Cascade)]
        GEO_PROVIDER[Geolocation Provider Interface]
        GEO_TRUST[Trust Validator Interface]
    end

    subgraph "Geolocation Sources"
        GEO_GPS[GPS Provider]
        GEO_IP[IP Provider]
        GEO_NET[Network Provider]
        GEO_SYS[System Provider]
    end

    subgraph "Entropy & Vector"
        VECTOR[Vector Engine<br/>Entropy Generation]
    end

    subgraph "External Sources"
        EXTERNAL[External Services<br/>IP Geocoding APIs]
    end

    UI --> CMD
    CMD --> CONFIG
    CMD --> GEN
    CMD --> UI
    CONFIG --> GEO_RESOLVER
    GEO_RESOLVER --> GEO_PROVIDER
    GEO_RESOLVER --> GEO_TRUST
    GEO_PROVIDER --> GEO_GPS
    GEO_PROVIDER --> GEO_IP
    GEO_PROVIDER --> GEO_NET
    GEO_PROVIDER --> GEO_SYS
    GEO_IP --> EXTERNAL
    GEN --> VALIDATOR
    GEN --> HASH
    GEN --> GEO_RESOLVER
    GEN --> CRYPTO
    HEALTH --> CONFIG
    UI --> THEME
    UI --> BANNER
    UI --> HEALTH
    GEO_RESOLVER --> VECTOR

    classDef primary fill:#2d3b4c,stroke:#61afef,color:#abb2bf
    classDef secondary fill:#3e4452,stroke:#98c379,color:#abb2bf
    classDef entropy fill:#2c323c,stroke:#e5c07b,color:#abb2bf
    classDef external fill:#2d3b4c,stroke:#e06c75,color:#abb2bf
    
    class CMD,CONFIG,GEN,CRYPTO,UI primary
    class VALIDATOR,HASH,THEME,BANNER,HEALTH secondary
    class GEO_RESOLVER,GEO_PROVIDER,GEO_TRUST,VECTOR entropy
    class GEO_GPS,GEO_IP,GEO_NET,GEO_SYS,EXTERNAL external
